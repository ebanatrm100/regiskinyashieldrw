# Copy this file to .streamlit/secrets.toml for local use (that file is git-ignored),
# or paste the same line into Streamlit Cloud: App -> Settings -> Secrets.
# NEVER commit a real key.
GEMINI_API_KEY = "paste-your-key-here"
# Optional: choose a model your Google account lists
# GEMINI_MODEL = "gemini-2.5-flash"
